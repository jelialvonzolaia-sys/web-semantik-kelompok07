    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Mhs_Andi">
        <rdf:type rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Student"/>
        <takesCourse rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#MK_WebSemantik"/>
        <hasNIM>220101001</hasNIM>
        <hasName>Andi Pratama</hasName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Mhs_Siti">
        <rdf:type rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Student"/>
        <takesCourse rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#MK_WebSemantik"/>
        <hasNIM>220101002</hasNIM>
        <hasName>Siti Rahma</hasName>
    </owl:NamedIndividual>
</rdf:RDF>