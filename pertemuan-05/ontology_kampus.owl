     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://contoh.github.io/web-semantik/220101001/kampus"/>

    <owl:ObjectProperty rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#belongsToDepartment">
        <rdfs:domain rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Person"/>
        <rdfs:range rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Department"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#takesCourse">
        <rdfs:domain rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Student"/>
        <rdfs:range rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Course"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#teachesCourse">
        <rdfs:domain rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Lecturer"/>
        <rdfs:range rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Course"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#hasNIM">
        <rdfs:domain rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#hasName">
        <rdfs:domain rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Course"/>
    <owl:Class rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Department"/>
    <owl:Class rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Person"/>

    <owl:Class rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Lecturer">
        <rdfs:subClassOf rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Person"/>
        <owl:disjointWith rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Student"/>
    </owl:Class>

    <owl:Class rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Student">
        <rdfs:subClassOf rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Person"/>
    </owl:Class>

    <owl:NamedIndividual rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Dept_IlmuKomputer">
        <rdf:type rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Department"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#MK_WebSemantik">
        <rdf:type rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Course"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://contoh.github.io/web-semantik/220101001/kampus#Dosen_Budi">
        <rdf:type rdf:resource="https://contoh.github.io/web-semantik/220101001/kampus#Lecturer"/>
