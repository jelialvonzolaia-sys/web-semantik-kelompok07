SELECT ?sungaiLabel ?panjang WHERE {
?sungai wdt:P31 wd:Q4022;   # P31: jenis entitas, Q4022: sungai
         wdt:P17 wd:Q252;   # P17: negara, Q252: Indonesia
         wdt:P2043 ?panjang. # P2043: panjang sungai

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "id,en".
  }
}
ORDER BY DESC(?panjang)
LIMIT 5
