# =====================================================================
# 4B. MASTER BAHASA DAERAH (ra:BahasaDaerah)
# =====================================================================

ra:bhs_mandailing a ra:BahasaDaerah ; ra:nama "Bahasa Mandailing" ; rdfs:label "Bahasa Mandailing" .
