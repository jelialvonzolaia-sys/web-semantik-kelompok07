ra:rumah_bagas_godang_panyabungan_tonga a ra:RumahAdat ;
    ra:nama "Bagas Godang Panyabungan Tonga" ;
    rdfs:label "Bagas Godang Panyabungan Tonga" ;
    ra:namaAlternatif "Bagas Godang, Sopo Godang, Sopo Eme, Hopuk, Alaman Bolak" ;
    ra:sejarah "Kediaman raja, pusat pemerintahan adat, dan tempat musyawarah atau perkara di Mandailing Natal; Alaman Bolak berfungsi sebagai lapangan upacara agung dan tanah suaka. Islamisasi mengubah ornamen zoomorf menjadi flora atau geometris." ;
    ra:fungsi "Kediaman raja, pusat pemerintahan adat, tempat musyawarah/perkara, serta ruang upacara dan sidang adat di Sopo Godang" ;
    ra:ciriArsitektur "Rumah panggung kayu berkolong dengan tangga ganjil (7 anak tangga di Huta Godang)" ;
    ra:bentukAtap "Atap pelana tipe sarotole dengan tutup ari (oloan ni angin) dan atap ijuk" ;
    ra:bahanBangunan "Kayu keras, ijuk, dan batu umpak; ornamen bolang merah-hitam-putih (bona bulu, mataniari, bintang, nihorbo, siadop-adop)" ;
    ra:maknaFilosofis "Sopo Godang tanpa dinding melambangkan demokrasi dan keterbukaan; warna merah-hitam-putih melambangkan Dalihan Na Tolu." ;
    ra:referensi "Kajian Arsitektur Bagas Godang Panyabungan Tonga & Pidoli Dolok (Univ. Malikussaleh): https://rama.unimal.ac.id/id/eprint/14451/ ; Efriani (UNIMED): https://digilib.unimed.ac.id/id/eprint/17742/ ; Saragi (UNIMED): https://media.neliti.com/ ; Serupa UNP: https://ejournal.unp.ac.id/index.php/serupa/" ;
    ra:berasalDariWilayah ra:wil_desa_panyabungan_tonga ;
    ra:dimilikiOlehSuku ra:suku_batak_mandailing ;
    ra:memilikiMarga ra:marga_nasution, ra:marga_lubis, ra:marga_batubara, ra:marga_matondang, ra:marga_rangkuti, ra:marga_parinduri, ra:marga_daulay, ra:marga_hasibuan, ra:marga_pulungan ;
    ra:menggunakanBahasa ra:bhs_mandailing ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_bagas_godang_pidoli_dolok a ra:RumahAdat ;
    ra:nama "Bagas Godang Pidoli Dolok" ;
    rdfs:label "Bagas Godang Pidoli Dolok" ;
    ra:namaAlternatif "Bagas Godang, Sopo Godang, Alaman Bolak" ;
    ra:sejarah "Bagian dari tradisi Bagas Godang di Kecamatan Panyabungan, Kabupaten Mandailing Natal, sebagai pusat pemerintahan adat dan musyawarah." ;
    ra:fungsi "Kediaman raja, pusat pemerintahan adat, dan tempat musyawarah/perkara" ;
    ra:ciriArsitektur "Rumah panggung kayu berkolong dengan tangga ganjil" ;
    ra:bentukAtap "Atap pelana tipe sarotole dengan tutup ari dan atap ijuk" ;
    ra:bahanBangunan "Kayu keras, ijuk, batu umpak, dan ornamen bolang merah-hitam-putih" ;
    ra:maknaFilosofis "Keterbukaan musyawarah adat dan nilai kekerabatan Dalihan Na Tolu" ;
    ra:referensi "Kajian Arsitektur Bagas Godang Panyabungan Tonga & Pidoli Dolok (Univ. Malikussaleh): https://rama.unimal.ac.id/id/eprint/14451/" ;
    ra:berasalDariWilayah ra:wil_desa_pidoli_dolok ;
    ra:dimilikiOlehSuku ra:suku_batak_mandailing ;
    ra:memilikiMarga ra:marga_nasution, ra:marga_lubis, ra:marga_batubara, ra:marga_matondang, ra:marga_rangkuti, ra:marga_parinduri, ra:marga_daulay, ra:marga_hasibuan, ra:marga_pulungan ;
    ra:menggunakanBahasa ra:bhs_mandailing ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_bagas_godang_huta_godang a ra:RumahAdat ;
    ra:nama "Bagas Godang Huta Godang Ulu Pungkut" ;
    rdfs:label "Bagas Godang Huta Godang Ulu Pungkut" ;
    ra:namaAlternatif "Bagas Godang Huta Godang" ;
    ra:sejarah "Bagas Godang di Desa Huta Godang, Kecamatan Ulu Pungkut, Mandailing Natal, dengan kajian makna simbolik dan ukiran tradisional." ;
    ra:fungsi "Kediaman raja, pusat pemerintahan adat, dan ruang upacara/sidang adat" ;
    ra:ciriArsitektur "Rumah panggung kayu berkolong dengan 7 anak tangga (tangga ganjil)" ;
    ra:bentukAtap "Atap pelana tipe sarotole dengan tutup ari dan atap ijuk" ;
    ra:bahanBangunan "Kayu keras, ijuk, batu umpak, dan ukiran bolang merah-hitam-putih" ;
    ra:maknaFilosofis "Simbolisme ornamen bolang dan tata nilai Dalihan Na Tolu" ;
    ra:referensi "Efriani, Makna Simbolik Rumah Adat Huta Godang Ulu Pungkut (UNIMED): https://digilib.unimed.ac.id/id/eprint/17742/ ; Ukiran Bagas Godang Huta Godang (Serupa UNP): https://ejournal.unp.ac.id/index.php/serupa/" ;
    ra:berasalDariWilayah ra:wil_desa_huta_godang_ulu_pungkut ;
    ra:dimilikiOlehSuku ra:suku_batak_mandailing ;
    ra:memilikiMarga ra:marga_nasution, ra:marga_lubis, ra:marga_batubara, ra:marga_matondang, ra:marga_rangkuti, ra:marga_parinduri, ra:marga_daulay, ra:marga_hasibuan, ra:marga_pulungan ;
    ra:menggunakanBahasa ra:bhs_mandailing ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_bagas_godang_angkola_sipirok a ra:RumahAdat ;
    ra:nama "Bagas Godang Angkola (Sipirok & Muara Tais)" ;
    rdfs:label "Bagas Godang Angkola (Sipirok & Muara Tais)" ;
    ra:namaAlternatif "Bagas Godang Kekuriaan, Bagas Godang Raja Luhat, Sopo Godang, Sopo Jago, Sopo Eme, Alaman Bolak" ;
    ra:sejarah "Pusat kekuriaan atau luhat (pemerintahan adat Angkola sebelum 1945), kediaman raja, tempat pembinaan naposo nauli bulung, serta tanah suaka perlindungan." ;
    ra:fungsi "Pusat pemerintahan adat kekuriaan/luhat, kediaman raja, sidang adat, serta upacara marhorja/horja godang" ;
    ra:ciriArsitektur "Rumah panggung setinggi 1,5 m di atas tanah dengan pembagian ruang pantar jolo, tonga, bilik parmodoman, dan balakang; fasad depan memiliki pahatan pedang bersilang (Silopso)" ;
    ra:bentukAtap "Atap pelana sarotole atau sililingkung dolok pancuran dengan tutup ari" ;
    ra:bahanBangunan "Kayu hutan/gunung, lantai meranti/kapur 20-30 cm, batu umpak, dan ornamen bolang merah-hitam-putih" ;
    ra:maknaFilosofis "Silopso melambangkan hukum adat; batu sidang di Alaman Bolak menjadi tempat pemutusan perkara adat Dalihan Na Tolu." ;
    ra:referensi "Manifestasi Tangible & Intangible Bagas Godang Kekuriaan Ulayat Angkola (Univ. Malikussaleh): https://rama.unimal.ac.id/id/eprint/14273/ ; Susilowati & Nasoichah: https://core.ac.uk/download/304207208.pdf ; Jurnal LGR UIN Syahada: https://jurnal.uinsyahada.ac.id/" ;
    ra:berasalDariWilayah ra:wil_sipirok_tapsel, ra:wil_muara_tais_tapsel, ra:wil_bunga_bondar_tapsel ;
    ra:dimilikiOlehSuku ra:suku_batak_angkola ;
    ra:memilikiMarga ra:marga_harahap, ra:marga_siregar, ra:marga_hasibuan, ra:marga_ritonga, ra:marga_rambe, ra:marga_daulay, ra:marga_pane, ra:marga_hutasuhut ;
    ra:menggunakanBahasa ra:bhs_angkola ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_bagas_godang_padang_lawas a ra:RumahAdat ;
    ra:nama "Bagas Godang Padang Lawas" ;
    rdfs:label "Bagas Godang Padang Lawas" ;
    ra:namaAlternatif "Bagas Godang (Tradisi Angkola-Mandailing Padang Lawas), Sopo Godang, Sopo Eme, Alaman Bolak" ;
    ra:sejarah "Mengikuti kajian tradisi Angkola-Mandailing di wilayah Padang Lawas (pemekaran dari Tapanuli Selatan tahun 2007); perlu verifikasi lapangan lanjutan (Candi Sipamutung merupakan situs arkeologi, bukan rumah adat)." ;
    ra:fungsi "Kediaman raja huta, pusat musyawarah adat, dan pelaksanaan ritual/upacara adat" ;
    ra:ciriArsitektur "Rumah panggung berkolong kayu dengan tangga ganjil (status data: perlu verifikasi lapangan)" ;
    ra:bentukAtap "Atap pelana sarotole atau lengkung sililingkung dolok pancuran dengan tutup ari" ;
    ra:bahanBangunan "Kayu keras, ijuk, batu umpak, dan bolang warna merah-hitam-putih" ;
    ra:maknaFilosofis "Prinsip Dalihan Na Tolu dan demokrasi musyawarah adat" ;
    ra:referensi "Hermansyah Lbs, Horja Godang di Sibuhuan Barumun Padang Lawas (UIN Sunan Kalijaga 2024): https://digilib.uin-suka.ac.id/66437/ ; UU No. 38 Tahun 2007: https://peraturan.go.id/" ;
    ra:berasalDariWilayah ra:wil_sibuhuan_barumun ;
    ra:dimilikiOlehSuku ra:suku_batak_angkola_mandailing ;
    ra:memilikiMarga ra:marga_hasibuan, ra:marga_harahap, ra:marga_daulay, ra:marga_siregar, ra:marga_nasution, ra:marga_lubis, ra:marga_rambe, ra:marga_ritonga ;
    ra:menggunakanBahasa ra:bhs_angkola_mandailing ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_bagas_godang_padang_lawas_utara a ra:RumahAdat ;
    ra:nama "Bagas Godang Padang Lawas Utara" ;
    rdfs:label "Bagas Godang Padang Lawas Utara" ;
    ra:namaAlternatif "Bagas Godang (Tradisi Angkola-Mandailing Padang Bolak), Sopo Godang, Sopo Eme, Alaman Bolak" ;
    ra:sejarah "Mengikuti kajian tradisi Angkola-Mandailing di Padang Bolak (pemekaran Tapanuli Selatan tahun 2007); perlu verifikasi lapangan lanjutan (Candi Bahal Portibi merupakan situs arkeologi)." ;
    ra:fungsi "Kediaman raja huta, pusat musyawarah adat, dan pelaksanaan upacara adat" ;
    ra:ciriArsitektur "Panggung kayu bertiang fondasi batu umpak (status data: perlu verifikasi lapangan)" ;
    ra:bentukAtap "Atap pelana berpenutup ari" ;
    ra:bahanBangunan "Kayu, ijuk tebal, batu umpak, dan bolang merah-hitam-putih" ;
    ra:maknaFilosofis "Nilai-nilai kekerabatan Dalihan Na Tolu" ;
    ra:referensi "UU No. 37 Tahun 2007 Pembentukan Kab. Padang Lawas Utara: https://peraturan.go.id/ ; Susilowati & Nasoichah: https://core.ac.uk/download/304207208.pdf" ;
    ra:berasalDariWilayah ra:wil_gunung_tua_padang_bolak ;
    ra:dimilikiOlehSuku ra:suku_batak_angkola_mandailing ;
    ra:memilikiMarga ra:marga_harahap, ra:marga_siregar, ra:marga_hasibuan, ra:marga_rambe, ra:marga_ritonga, ra:marga_daulay, ra:marga_pane ;
    ra:menggunakanBahasa ra:bhs_angkola_mandailing ;
    ra:memilikiOrnamen ra:orn_bolang ;
    ra:memilikiTradisi ra:trd_horja_godang, ra:trd_mangupa, ra:trd_sidang_adat_dalihan_na_tolu .

ra:rumah_adat_pasisi_rajo_sorkam_kanan a ra:RumahAdat ;
    ra:nama "Rumah Adat Pasisi (Rumah Rajo Sorkam Kanan)" ;
    rdfs:label "Rumah Adat Pasisi (Rumah Rajo Sorkam Kanan)" ;
    ra:namaAlternatif "Rumah Adat Pesisir, Rumah Adat Batak Pesisir / Pasisi" ;
    ra:sejarah "Kediaman Raja Sorkam Pesisir yang masih difungsikan keturunannya; diajukan perlindungan WBTB/OPK pada Agustus 2025 (status data terbatas)." ;
    ra:fungsi "Kediaman adat Raja Sorkam Pesisir dan ruang kegiatan adat/keluarga" ;
    ra:ciriArsitektur "Rumah panggung kayu berkolong dengan tangga dan tiang; terali jendela memiliki ukiran saluk uki khas Pesisir" ;
    ra:bentukAtap "Arsitektur panggung pesisir barat Tapanuli" ;
    ra:bahanBangunan "Kayu keras pesisir, papan kayu, dan ragam hias khas Pasisi" ;
    ra:maknaFilosofis "Kearifan adaptasi masyarakat bahari pesisir barat Tapanuli" ;
    ra:referensi "EGINDO (7 Sept 2025): https://egindo.com/gabema-tapteng-sibolga/ ; Sehat dkk. (Mukadimah 2021): https://core.ac.uk/download/387527467.pdf ; Pratiwi (UNIMED 2020): https://digilib.unimed.ac.id/42756/ ; BRIN: https://karya.brin.go.id/26705/" ;
    ra:berasalDariWilayah ra:wil_sorkam_kanan_tapteng ;
    ra:dimilikiOlehSuku ra:suku_etnis_pasisi ;
    ra:memilikiMarga ra:marga_tanjung, ra:marga_pohan, ra:marga_pasaribu, ra:marga_limbong, ra:marga_matondang, ra:marga_tarihoran, ra:marga_bondar, ra:marga_marbun ;
    ra:menggunakanBahasa ra:bhs_pesisir ;
    ra:memilikiOrnamen ra:orn_saluk_uki ;
    ra:memilikiTradisi ra:trd_adat_sumando, ra:trd_turun_ka_rai .

ra:rumah_adat_pasisi_sibolga a ra:RumahAdat ;
    ra:nama "Rumah Adat Pasisi (Pesisir Sibolga)" ;
    rdfs:label "Rumah Adat Pasisi (Pesisir Sibolga)" ;
    ra:namaAlternatif "Rumah Panggung Vernakular Pesisir Sibolga" ;
    ra:sejarah "Terkait sejarah Sibolga sebagai kota pelabuhan historis keresidenan Tapanuli; rumah panggung atas air Pasar Belakang merupakan vernakular nelayan, bukan rumah adat resmi (status data terbatas)." ;
    ra:fungsi "Hunian bahari dan ruang adat etnis Pesisir Sibolga" ;
    ra:ciriArsitektur "Rumah panggung berkolong kayu dengan ventilasi kisi-kisi angin pantai dan terali saluk uki" ;
    ra:bentukAtap "Arsitektur panggung pesisir barat Sumatera Utara" ;
    ra:bahanBangunan "Kayu dan elemen kisi-kisi angin serta terali saluk uki" ;
    ra:maknaFilosofis "Keterbukaan komunitas bahari Negeri Berbilang Kaum di pesisir Sibolga" ;
    ra:referensi "Tari Tradisional Rande & Adat Pernikahan Pesisir Sibolga (Gesture UNIMED): https://jurnal.unimed.ac.id/2012/index.php/gesture/article/view/19828/ ; Budaya Baso (Informatio UNPAD): https://journals.unpad.ac.id/informatio/article/view/49248 ; UGM: https://ugm.ac.id/" ;
    ra:berasalDariWilayah ra:wil_kota_sibolga ;
    ra:dimilikiOlehSuku ra:suku_etnis_pasisi_sibolga ;
    ra:memilikiMarga ra:marga_tanjung, ra:marga_pohan, ra:marga_pasaribu, ra:marga_limbong, ra:marga_sikumbang ;
    ra:menggunakanBahasa ra:bhs_pesisir_sibolga ;
    ra:memilikiOrnamen ra:orn_saluk_uki ;
    ra:memilikiTradisi ra:trd_adat_pernikahan_pesisir_sibolga, ra:trd_budaya_baso .

ra:rumah_bagas_godang_h_raja_tagor a ra:RumahAdat ;
    ra:nama "Bagas Godang H. Raja Tagor" ;
    rdfs:label "Bagas Godang H. Raja Tagor" ;
    ra:namaAlternatif "Bagas Godang Hutaimbaru, Sopo Godang, Alaman Bolak" ;
    ra:sejarah "Peninggalan budaya Angkola pimpinan H. Raja Tagor di Desa Hutaimbaru, Kota Padangsidimpuan." ;
    ra:fungsi "Kediaman pemimpin adat, balai musyawarah perkara, dan sarana edukasi kebudayaan" ;
    ra:ciriArsitektur "Rumah panggung tiang kayu besar di atas umpak batu kali" ;
    ra:bentukAtap "Atap melengkung khas Angkola (sililingkung dolok pancuran) dengan tutup ari" ;
    ra:bahanBangunan "Kayu pilihan tahan lama dan ornamen bolang ukiran merah-hitam-putih" ;
    ra:maknaFilosofis "Kepemimpinan, keberanian, persatuan, dan keharmonisan Dalihan Na Tolu" ;
    ra:referensi "Gurusinga dkk., Sejarah Berdirinya Bagas Godang H. Raja Tagor Hutaimbaru Padangsidimpuan (Ristekdik 2026): https://jurnal.um-tapsel.ac.id/index.php/Ristekdik/article/download/26205/pdf ; Univ. Malikussaleh: https://rama.unimal.ac.id/14273/" ;
    ra:berasalDariWilayah ra:wil_desa_hutaimbaru_padangsidimpuan ;
    ra:dimilikiOlehSuku ra:suku_batak_angkola ;
    ra:memilikiMarga ra:marga_harahap, ra:marga_siregar, ra:marga_hasibuan, ra:marga_tobing, ra:marga_ritonga, ra:marga_hutasuhut ;
    ra:menggunakanBahasa ra:bhs_angkola ;
