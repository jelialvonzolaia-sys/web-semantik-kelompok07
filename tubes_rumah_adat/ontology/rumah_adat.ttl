    # =====================================================================
# 5D. RUMAH ADAT — BAGIAN JONA
# =====================================================================

# --- A. Tapanuli Utara — Rumah Bolon Pulau Sibandang (TAP-01) ---
ra:rumah_bolon_pulau_sibandang a ra:RumahAdat ;
    ra:nama "Rumah Bolon Pulau Sibandang" ;
    ra:namaAlternatif "Rumah Bolon Sibandang" ;
    ra:sejarah "Rumah tradisional bersejarah di Pulau Sibandang, Kecamatan Muara, Kabupaten Tapanuli Utara, yang diperkirakan berasal dari abad ke-18." ;
    ra:fungsi "Hunian historis dan penanda warisan keluarga atau huta" ;
    ra:ciriArsitektur "Rumah panggung bertiang kayu besar khas Batak Toba" ;
    ra:bentukAtap "Atap melengkung tinggi menyerupai punggung kerbau" ;
    ra:bahanBangunan "Kayu keras, ijuk tebal, batu ojahan, dan ornamen gorga Batak Toba" ;
    ra:maknaFilosofis "Keterkaitan struktur kekerabatan Dalihan Na Tolu dan kosmos Batak Toba." ;
    ra:referensi "Sinata: https://sinata.id/rumah-bolon-sibandang/ ; Repositori Kemendikdasmen: https://repositori.kemendikdasmen.go.id/7603/" ;
    ra:berasalDariWilayah ra:wil_pulau_sibandang_taput ;
    ra:dimilikiOlehSuku ra:suku_batak_toba ;
    ra:menggunakanBahasa ra:bhs_batak_toba ;
    ra:memilikiOrnamen ra:orn_gorga ;
    ra:memilikiTradisi ra:trd_manortor .

# --- B. Toba — Rumah Bolon Museum TB Silalahi Center (TOB-01) ---
ra:rumah_bolon_museum_tb_silalahi_center a ra:RumahAdat ;
    ra:nama "Rumah Bolon Kompleks TB Silalahi Center" ;
    ra:namaAlternatif "Rumah Bolon Museum TB Silalahi" ;
    ra:sejarah "Bangunan rumah adat skala besar di pusat pelestarian budaya Batak di Balige, Kabupaten Toba." ;
    ra:fungsi "Sarana edukasi, museum etnografi, dan pelestarian arsitektur Batak" ;
    ra:ciriArsitektur "Konstruksi kayu megah berarsitektur Batak Toba masif" ;
    ra:bentukAtap "Atap melengkung ijuk tinggi khas Ruma Bolon" ;
    ra:bahanBangunan "Kayu keras pilihan, ijuk, batu kali, dan ornamen gorga berukir warna merah, hitam, dan putih" ;
    ra:maknaFilosofis "Pelestarian identitas budaya Batak Toba bagi generasi muda." ;
    ra:referensi "Museum TB Silalahi Center: https://museumtbsilalahicenter.blogspot.com/ ; Wisata Toba: https://wisata.tobakab.go.id/" ;
    ra:berasalDariWilayah ra:wil_balige_toba ;
    ra:dimilikiOlehSuku ra:suku_batak_toba ;
    ra:menggunakanBahasa ra:bhs_batak_toba ;
    ra:memilikiOrnamen ra:orn_gorga ;
    ra:memilikiTradisi ra:trd_manortor .

# --- C. Toba — Huta Batak TB Silalahi Center (TOB-02) ---
ra:rumah_huta_batak_tb_silalahi_center a ra:RumahAdat ;
    ra:nama "Huta Batak TB Silalahi Center" ;
    ra:namaAlternatif "Kompleks Kumpulan Rumah Adat Huta Batak" ;
    ra:sejarah "Kelompok rumah tradisional tua yang direkonstruksi atau dipindahkan ke museum di Balige, Kabupaten Toba." ;
    ra:fungsi "Koleksi etnografi pemukiman tradisional Huta Batak, demonstrasi budaya, dan interpretasi warisan" ;
    ra:ciriArsitektur "Deretan Ruma dan Sopo berhadapan membentuk pola Huta tradisional" ;
    ra:bentukAtap "Atap ijuk tinggi melengkung" ;
    ra:bahanBangunan "Kayu tua masif, ijuk, pasak kayu, dan ornamen gorga Batak pada penutup ari serta dinding" ;
    ra:maknaFilosofis "Tata ruang permukiman Huta Batak yang harmonis." ;
    ra:referensi "Museum TB Silalahi Center: https://museumtbsilalahicenter.blogspot.com/ ; Digilib Unimed: https://digilib.unimed.ac.id/19951/" ;
