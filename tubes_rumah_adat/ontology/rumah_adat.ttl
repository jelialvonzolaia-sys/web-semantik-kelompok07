# --- E. Humbang Hasundutan — Kompleks Istana Sisingamangaraja (HUM-01 s/d HUM-04) ---
ra:rumah_kompleks_istana_sisingamangaraja_bakkara a ra:RumahAdat ;
    ra:nama "Kompleks Istana Sisingamangaraja (Bakkara)" ;
    ra:namaAlternatif "Ruma Bolon (HUM-01), Ruma Parsaktian (HUM-02), Sopo Bolon (HUM-03), Sopo Godang (HUM-04)" ;
    ra:sejarah "Kompleks istana peninggalan Pahlawan Nasional Raja Sisingamangaraja XII di lembah Bakkara, Desa Simamora, Kecamatan Baktiraja, Humbang Hasundutan." ;
    ra:fungsi "Cagar budaya, sejarah perjuangan, situs sakral adat, tempat musyawarah dan tamu (Ruma Bolon), kediaman raja (Ruma Parsaktian), lumbung hasil panen (Sopo Bolon), serta balai seni dan kegiatan masyarakat (Sopo Godang)" ;
    ra:ciriArsitektur "Rekonstruksi arsitektur Ruma dan Sopo Batak Toba di hamparan lembah Bakkara" ;
    ra:bentukAtap "Atap ijuk melengkung khas Batak Toba" ;
    ra:bahanBangunan "Kayu keras, ijuk, batu alam, dan ornamen gorga Batak Toba dengan simbol keagungan kepemimpinan" ;
    ra:maknaFilosofis "Pusat spiritual, perjuangan, dan kepemimpinan Raja Sisingamangaraja." ;
    ra:referensi "Sinar Humbang Hasundutan: https://sinar.humbanghasundutankab.go.id/ ; IAKN Tarutung: https://e-journal.iakntarutung.ac.id/" ;
    ra:berasalDariWilayah ra:wil_bakkara_humbahas ;
    ra:dimilikiOlehSuku ra:suku_batak_toba ;
    ra:memilikiMarga ra:marga_sinambela ;
    ra:menggunakanBahasa ra:bhs_batak_toba ;
    ra:memilikiOrnamen ra:orn_gorga ;
    ra:memilikiTradisi ra:trd_manortor .

# --- F. Samosir — Huta Siallagan, Simanindo & Tomok (SAM-01 s/d SAM-05) ---
ra:rumah_huta_siallagan_simanindo_tomok_samosir a ra:RumahAdat ;
    ra:nama "Kompleks Rumah Adat Samosir (Huta Siallagan, Simanindo, Tomok & Hutaginjang)" ;
    ra:namaAlternatif "Ruma Bolon & Sopo Huta Siallagan (SAM-01 & SAM-02), Museum Huta Bolon Simanindo (SAM-03), Rumah Adat Kawasan Tomok (SAM-04), Permukiman Desa Hutaginjang (SAM-05)" ;
    ra:sejarah "Pusat kebudayaan tua Batak Toba di Pulau Samosir yang mencakup Ambarita, Simanindo, Tomok, dan Sianjur Mula-mula." ;
    ra:fungsi "Hunian raja adat, tempat sidang hukum adat Batu Parsidangan, lumbung atau balai, dan museum budaya" ;
    ra:ciriArsitektur "Komposisi Ruma (hunian) dan Sopo (lumbung atau balai) saling berhadapan mengapit alaman" ;
    ra:bentukAtap "Atap melengkung ijuk tinggi dengan haluan tajam" ;
    ra:bahanBangunan "Kayu keras antik, ijuk, batu benteng huta, dan ornamen Gorga Singa-singa, Gorga Ulu Paung, serta Ipon-ipon" ;
    ra:maknaFilosofis "Kosmologi Banua Ginjang, Banua Tonga, Banua Toru serta penegakan hukum adat." ;
    ra:referensi "Indonesia Travel: https://www.indonesia.travel/ ; Repository UNPAR: https://repository.unpar.ac.id/handle/123456789/7704" ;
    ra:berasalDariWilayah ra:wil_pulau_samosir ;
    ra:dimilikiOlehSuku ra:suku_batak_toba ;
    ra:memilikiMarga ra:marga_siallagan, ra:marga_sidauruk, ra:marga_sidabutar, ra:marga_sagala ;
    ra:menggunakanBahasa ra:bhs_batak_toba ;
    ra:memilikiOrnamen ra:orn_gorga ;
    ra:memilikiTradisi ra:trd_manortor, ra:trd_mangalahat_horbo .


    # =====================================================================
# 5E. RUMAH ADAT — BAGIAN PATRICIA
# =====================================================================

# --- A. Simalungun — Kompleks Rumah Bolon Pamatang Purba (SIM-01 s/d SIM-06) ---
ra:rumah_bolon_pamatang_purba_simalungun a ra:RumahAdat ;
    ra:nama "Kompleks Rumah Bolon Pamatang Purba" ;
    ra:namaAlternatif "Rumah Bolon Purba (SIM-01), Balei Bolon (SIM-02), Balei Buttu (SIM-03), Jabu Jungga (SIM-04), Pattangan Raja & Permaisuri (SIM-05), Jambur & Rumah Losung (SIM-06)" ;
    ra:sejarah "Kompleks Istana Kerajaan Purba yang didirikan oleh Raja Purba di Nagori Pamatang Purba, Kecamatan Purba, Kabupaten Simalungun; dahulu pusat pemerintahan kerajaan Simalungun dan kini menjadi situs cagar budaya nasional." ;
    ra:fungsi "Pusat pemerintahan kerajaan Simalungun, cagar budaya nasional, istana raja, balai musyawarah dan pengadilan, pos pengawal, hunian panglima perang, tempat istirahat dan menenun, serta penginapan tamu dan penumbukan padi" ;
    ra:ciriArsitektur "Rumah panggung kayu dengan tiang-tiang kayu bulat besar" ;
    ra:bentukAtap "Atap ijuk tinggi bertingkat melengkung khas Simalungun dengan ornamen kepala kerbau di puncaknya" ;
    ra:bahanBangunan "Kayu ingul atau kayu hutan, ijuk tebal, bambu, batu umpak, serta ornamen pinar (ukiran Simalungun seperti Pinar Bunga Sayur Matua dan Pinar Hambing) berwarna merah, putih, dan hitam" ;
    ra:maknaFilosofis "Martabat kepemimpinan Raja Purba, kebersamaan, dan ketahanan hukum adat Simalungun." ;
    ra:referensi "BPODT: https://bpodt.kemenpar.go.id/rumah-bolon-purba-istana-para-raja/ ; Repositori Kemendikdasmen: https://repositori.kemendikdasmen.go.id/8260/" ;
    ra:berasalDariWilayah ra:wil_nagori_pamatang_purba_simalungun ;
    ra:dimilikiOlehSuku ra:suku_batak_simalungun ;
    ra:memilikiMarga ra:marga_purba ;
    ra:menggunakanBahasa ra:bhs_simalungun ;
    ra:memilikiOrnamen ra:orn_pinar ;
    ra:memilikiTradisi ra:trd_manortor .

# --- B. Pematangsiantar — Museum Simalungun (PMS-01) ---
ra:rumah_museum_simalungun_pematangsiantar a ra:RumahAdat ;
    ra:nama "Museum Simalungun" ;
    ra:namaAlternatif "Rumah Pusaka Simalungun" ;
    ra:sejarah "Didirikan atas musyawarah raja-raja Simalungun (April-Desember 1939) dan diresmikan secara adat pada 30 April 1940 di Kota Pematangsiantar." ;
    ra:fungsi "Museum pemeliharaan artefak, pameran budaya, dan pelestarian identitas Simalungun" ;
    ra:ciriArsitektur "Bangunan bergaya Ruma Bolon Simalungun bertiang panggung kayu" ;
    ra:bentukAtap "Atap ijuk bertingkat khas arsitektur Simalungun" ;
    ra:bahanBangunan "Kayu, plester, ijuk, serta ornamen pinar khas Simalungun pada dinding dan gunungan atap" ;
    ra:maknaFilosofis "Wadah pemersatu warisan budaya 7 kerajaan Simalungun." ;
    ra:referensi "Museum Kemenbud: https://museum.kemenbud.go.id/ ; Indonesia Travel: https://www.indonesia.travel/" ;
    ra:berasalDariWilayah ra:wil_kota_pematangsiantar ;
    ra:dimilikiOlehSuku ra:suku_batak_simalungun ;
    ra:menggunakanBahasa ra:bhs_simalungun ;
    ra:memilikiOrnamen ra:orn_pinar .

# --- C. Batu Bara — Istana Niat Lima Laras (BTB-01) ---
ra:rumah_istana_niat_lima_laras_batubara a ra:RumahAdat ;
    ra:nama "Istana Niat Lima Laras" ;
    ra:namaAlternatif "Istana Datuk Muhammad Yuda" ;
    ra:sejarah "Dibangun pada tahun 1907-1912 oleh Datuk Muhammad Yuda sebagai pemenuhan nazar di Desa Lima Laras, Kecamatan Tanjung Tiram, Kabupaten Batu Bara." ;
    ra:fungsi "Istana kediaman dan pusat kedatuan Melayu Lima Laras" ;
    ra:ciriArsitektur "Perpaduan arsitektur Melayu dan Eropa bertingkat 4 dengan 6 anjungan, 28 pintu, dan 66 pasang jendela" ;
    ra:bentukAtap "Atap limas Melayu bertingkat yang megah" ;
    ra:bahanBangunan "Kombinasi beton, kayu ulin atau meranti, kaca patri, serta ragam hias Melayu seperti motif itik pulang petang, pucuk rebung, dan awan larat" ;
    ra:maknaFilosofis "Kehormatan, pemenuhan nazar (niat), dan keagungan tradisi bahari Melayu Batu Bara." ;
    ra:referensi "Disporabudpar Batu Bara: https://disporabudpar.batubarakab.go.id/ ; Jurnal Community UTU: https://jurnal.utu.ac.id/jcommunity/article/download/6651/3769" ;
    ra:berasalDariWilayah ra:wil_desa_lima_laras_batubara ;
    ra:dimilikiOlehSuku ra:suku_melayu_pesisir_batu_bara ;
    ra:menggunakanBahasa ra:bhs_melayu ;
    ra:memilikiOrnamen ra:orn_pucuk_rebung, ra:orn_awan_larat ;
    ra:memilikiTradisi ra:trd_tepung_tawar .

# --- D. Serdang Bedagai — Replika Istana Darul Arif (SDB-01) ---
ra:rumah_replika_istana_darul_arif_serdang_bedagai a ra:RumahAdat ;
    ra:nama "Replika Istana Darul Arif" ;
    ra:namaAlternatif "Istana Sultan Serdang" ;
    ra:sejarah "Replika dari istana bersejarah Kesultanan Serdang di Kota Galuh (berdiri tahun 1889 masa Sultan Sulaiman Syariful Alamsyah) yang berada di Kecamatan Perbaungan, Kabupaten Serdang Bedagai." ;
    ra:fungsi "Penanda sejarah dan pusat kegiatan budaya Melayu Serdang" ;
    ra:ciriArsitektur "Arsitektur istana panggung Melayu Serdang berukuran besar dengan baluarte atau beranda" ;
    ra:bentukAtap "Atap limas bumbungan Melayu bertingkat berwarna kuning dan hijau" ;
    ra:bahanBangunan "Kayu, struktur modern pendukung, serta ukiran Melayu Serdang, selembayung, dan lebah bergantung" ;
    ra:maknaFilosofis "Kebangkitan sejarah Kesultanan Serdang dan identitas Melayu." ;
    ra:referensi "Simponi Sumut: https://simponisumut.sumutprov.go.id/ ; Portal Resmi Pemkab Serdang Bedagai" ;
    ra:berasalDariWilayah ra:wil_perbaungan_serdang_bedagai ;
    ra:dimilikiOlehSuku ra:suku_melayu_serdang ;
    ra:menggunakanBahasa ra:bhs_melayu ;
    ra:memilikiOrnamen ra:orn_selembayung, ra:orn_lebah_bergantung ;
    ra:memilikiTradisi ra:trd_tepung_tawar .

# --- E. Wilayah Belum Teridentifikasi Bangunan Fisik Spesifik (Bagian Patricia) ---
ra:rumah_status_inventarisasi_wilayah_patricia a ra:RumahAdat ;
    ra:nama "Status Inventarisasi Wilayah Belum Teridentifikasi Fisik Spesifik (Asahan, Tanjungbalai, Tebing Tinggi, Labuhanbatu)" ;
