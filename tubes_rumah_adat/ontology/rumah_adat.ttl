@prefix ra:   <http://example.org/ontology/rumah-adat#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontology/rumah-adat> a owl:Ontology ;
    rdfs:label "Ontologi Rumah Adat Sumatera Utara" ;
    rdfs:comment "Skema ontologi dan dataset RDF inventarisasi rumah adat di Provinsi Sumatera Utara." .

# =====================================================================
# 1. CLASSES (7 Kelas Inti)
# =====================================================================

ra:RumahAdat a owl:Class ;
    rdfs:label "Rumah Adat" ;
    rdfs:comment "Bangunan rumah adat tradisional di Sumatera Utara." .

ra:Suku a owl:Class ;
    rdfs:label "Suku" ;
    rdfs:comment "Kelompok etnis pemilik atau pembangun rumah adat." .

ra:Marga a owl:Class ;
    rdfs:label "Marga" ;
    rdfs:comment "Klan/marga kekerabatan yang berafiliasi dengan rumah adat atau suku." .

ra:BahasaDaerah a owl:Class ;
    rdfs:label "Bahasa Daerah" ;
    rdfs:comment "Bahasa daerah yang digunakan pada komunitas rumah adat." .

ra:Wilayah a owl:Class ;
    rdfs:label "Wilayah" ;
    rdfs:comment "Lokasi geografis bertingkat (Desa/Kecamatan, Kabupaten/Kota, Provinsi)." .

ra:Tradisi a owl:Class ;
    rdfs:label "Tradisi" ;
    rdfs:comment "Upacara adat, ritual, atau praktik budaya terkait rumah adat." .

ra:Ornamen a owl:Class ;
    rdfs:label "Ornamen" ;
    rdfs:comment "Ukiran, motif, atau ragam hias arsitektur rumah adat." .

# =====================================================================
# 2. OBJECT PROPERTIES (Relasi Antar-Kelas)
# =====================================================================

ra:berasalDariWilayah a owl:ObjectProperty ;
    rdfs:label "berasal dari wilayah" ;
    rdfs:comment "Lokasi asal rumah adat." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:Wilayah .

ra:dimilikiOlehSuku a owl:ObjectProperty ;
    rdfs:label "dimiliki oleh suku" ;
    rdfs:comment "Suku pemilik rumah adat." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:Suku .

ra:memilikiMarga a owl:ObjectProperty ;
    rdfs:label "memiliki marga" ;
    rdfs:comment "Marga yang berafiliasi dengan rumah adat." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:Marga .

ra:menggunakanBahasa a owl:ObjectProperty ;
    rdfs:label "menggunakan bahasa" ;
    rdfs:comment "Bahasa yang digunakan di rumah adat." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:BahasaDaerah .

ra:memilikiTradisi a owl:ObjectProperty ;
    rdfs:label "memiliki tradisi" ;
    rdfs:comment "Tradisi/upacara yang berkaitan." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:Tradisi .

ra:memilikiOrnamen a owl:ObjectProperty ;
    rdfs:label "memiliki ornamen" ;
    rdfs:comment "Ornamen/ukiran khas bangunan." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range ra:Ornamen .

ra:menuturkanBahasa a owl:ObjectProperty ;
    rdfs:label "menuturkan bahasa" ;
    rdfs:comment "Relasi multi-hop Suku ke Bahasa." ;
    rdfs:domain ra:Suku ;
    rdfs:range ra:BahasaDaerah .

ra:bagianDariSuku a owl:ObjectProperty ;
    rdfs:label "bagian dari suku" ;
    rdfs:comment "Relasi multi-hop Marga ke Suku." ;
    rdfs:domain ra:Marga ;
    rdfs:range ra:Suku .

ra:bagianDariWilayah a owl:ObjectProperty ;
    rdfs:label "bagian dari wilayah" ;
    rdfs:comment "Relasi transitif Desa/Kecamatan ke Kabupaten/Kota ke Provinsi." ;
    rdfs:domain ra:Wilayah ;
    rdfs:range ra:Wilayah .

# =====================================================================
# 3. DATATYPE PROPERTIES (Atribut Teks & Link)
# =====================================================================

ra:nama a owl:DatatypeProperty ;
    rdfs:label "nama" ;
    rdfs:comment "Nama utama entitas." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ra:namaAlternatif a owl:DatatypeProperty ;
    rdfs:label "nama alternatif" ;
    rdfs:comment "Sebutan atau nama lain rumah adat." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:sejarah a owl:DatatypeProperty ;
    rdfs:label "sejarah" ;
    rdfs:comment "Latar belakang sejarah bangunan." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:fungsi a owl:DatatypeProperty ;
    rdfs:label "fungsi" ;
    rdfs:comment "Fungsi sosial, adat, atau hunian." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:ciriArsitektur a owl:DatatypeProperty ;
    rdfs:label "ciri arsitektur" ;
    rdfs:comment "Karakteristik struktur & konstruksi." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:bentukAtap a owl:DatatypeProperty ;
    rdfs:label "bentuk atap" ;
    rdfs:comment "Deskripsi bentuk dan model atap." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:bahanBangunan a owl:DatatypeProperty ;
    rdfs:label "bahan bangunan" ;
    rdfs:comment "Material utama pembentuk bangunan." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:maknaFilosofis a owl:DatatypeProperty ;
    rdfs:label "makna filosofis" ;
    rdfs:comment "Nilai filosofis dan simbolik." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

ra:linkFoto a owl:DatatypeProperty ;
    rdfs:label "link foto" ;
    rdfs:comment "Tautan URL gambar rumah adat (opsional)." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:anyURI .

ra:referensi a owl:DatatypeProperty ;
    rdfs:label "referensi" ;
    rdfs:comment "Catatan/tautan rujukan singkat (opsional)." ;
    rdfs:domain ra:RumahAdat ;
    rdfs:range xsd:string .

    
    # =====================================================================
# 4A. MASTER WILAYAH (ra:Wilayah)
# =====================================================================

ra:wil_sumatera_utara a ra:Wilayah ;
    ra:nama "Sumatera Utara" .

