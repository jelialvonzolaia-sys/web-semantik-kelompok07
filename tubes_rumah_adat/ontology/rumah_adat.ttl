    ra:bentukAtap "Atap melengkung ijuk hitam" ;
    ra:bahanBangunan "Kayu tua, ijuk, batu umpak, dan ornamen gorga ukir kayu antik" ;
    ra:maknaFilosofis "Keaslian arsitektur vernakular Batak Toba abad ke-18." ;
    ra:referensi "Indonesia Travel: https://www.indonesia.travel/ ; Repositori Kemendikdasmen: https://repositori.kemendikdasmen.go.id/7603/" ;
