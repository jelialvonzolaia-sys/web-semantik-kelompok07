# =====================================================================
# 4D. MASTER MARGA (ra:Marga)
# =====================================================================

ra:marga_nasution a ra:Marga ; ra:nama "Nasution" ; ra:bagianDariSuku ra:suku_batak_mandailing .
ra:marga_lubis a ra:Marga ; ra:nama "Lubis" ; ra:bagianDariSuku ra:suku_batak_mandailing .
