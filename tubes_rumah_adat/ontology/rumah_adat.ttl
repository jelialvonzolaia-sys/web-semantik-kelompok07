ra:rumah_balai_adat_melayu_asahan a ra:RumahAdat ;
    ra:nama "Balai Adat Melayu Asahan" ;
    rdfs:label "Balai Adat Melayu Asahan" ;
    ra:namaAlternatif "Rumah Besar Melayu Asahan, Balai Melayu Kisaran" ;
    ra:sejarah "Representasi arsitektur panggung Melayu pesisir timur yang berakar dari tradisi Kesultanan Asahan di kawasan aliran Sungai Asahan." ;
    ra:fungsi "Balai musyawarah adat Melayu Asahan, upacara perkawinan, dan pelestarian seni budaya daerah" ;
    ra:ciriArsitektur "Rumah panggung kayu berkolong dengan tangga depan simetris, serambi luas, serta pembagian ruang balai utama dan ruang dalam" ;
    ra:bentukAtap "Atap limas bumbungan bertingkat dengan selembayung dan hiasan lebah bergantung pada lisplank" ;
    ra:bahanBangunan "Kayu meranti dan ulin, papan kayu berukir, serta atap genteng atau sirap" ;
    ra:maknaFilosofis "Keterbukaan musyawarah mufakat masyarakat Melayu Asahan dan keseimbangan hidup pesisir." ;
    ra:referensi "Inventarisasi Budaya Melayu Pesisir Timur Sumatera Utara (Pemkab Asahan & BPK Wilayah II)" ;
