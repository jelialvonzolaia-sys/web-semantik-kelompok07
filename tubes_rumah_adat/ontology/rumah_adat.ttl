    ra:memilikiMarga ra:marga_purba ;
    ra:menggunakanBahasa ra:bhs_simalungun ;
    ra:memilikiOrnamen ra:orn_pinar ;
    ra:memilikiTradisi ra:trd_manortor, ra:trd_rondang_bintang .

