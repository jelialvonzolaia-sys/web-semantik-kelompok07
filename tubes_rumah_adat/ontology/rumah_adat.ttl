    ra:memilikiTradisi ra:trd_tepung_tawar, ra:trd_jamu_laut .

ra:rumah_istana_kesultanan_asahan_tanjungbalai a ra:RumahAdat ;
    ra:nama "Rumah Adat & Istana Kesultanan Asahan Tanjungbalai" ;
    rdfs:label "Rumah Adat & Istana Kesultanan Asahan Tanjungbalai" ;
    ra:namaAlternatif "Istana Raja Asahan, Rumah Panggung Melayu Muara Sungai Asahan" ;
    ra:sejarah "Pusat sejarah Kesultanan Asahan di Kota Tanjungbalai yang berkembang di pertemuan Sungai Asahan dan Sungai Silau sebagai bandar maritim Melayu." ;
    ra:fungsi "Kediaman bangsawan kesultanan, pusat pemerintahan adat, dan upacara penyambutan tamu agung" ;
    ra:ciriArsitektur "Bangunan panggung kayu megah menghadap sungai dengan beranda luas, kisi-kisi angin berukir, dan warna kuning-hijau khas Melayu" ;
    ra:bentukAtap "Atap limas Melayu bersusun dengan puncak selembayung" ;
    ra:bahanBangunan "Kayu keras pesisir, papan berukir awan larat, serta ornamen lebah bergantung" ;
    ra:maknaFilosofis "Kejayaan maritim Kesultanan Asahan dan keagungan adat bersendikan syarak." ;
    ra:referensi "Arsip Sejarah Kesultanan Asahan & Disparpora Kota Tanjungbalai" ;
