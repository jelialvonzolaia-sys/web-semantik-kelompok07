    ra:berkerabatDenganSuku ra:suku_etnis_pasisi, ra:suku_melayu .

ra:suku_nias a ra:Suku ;
    ra:nama "Suku Nias" ;
    rdfs:label "Suku Nias" ;
    ra:menuturkanBahasa ra:bhs_nias .

ra:suku_melayu_deli a ra:Suku ;
    ra:nama "Suku Melayu Deli" ;
    rdfs:label "Suku Melayu Deli" ;
    ra:menuturkanBahasa ra:bhs_melayu_deli ;
    ra:berkerabatDenganSuku ra:suku_melayu_langkat, ra:suku_melayu_pesisir_batu_bara, ra:suku_melayu_serdang, ra:suku_melayu .

