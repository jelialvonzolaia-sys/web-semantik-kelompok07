# =====================================================================
# 4C. MASTER SUKU (ra:Suku)
# =====================================================================

ra:suku_batak_mandailing a ra:Suku ;
    ra:nama "Suku Batak Mandailing" ;
    rdfs:label "Suku Batak Mandailing" ;
    ra:menuturkanBahasa ra:bhs_mandailing ;
    ra:berkerabatDenganSuku ra:suku_batak_angkola, ra:suku_batak_angkola_mandailing .

ra:suku_batak_angkola a ra:Suku ;
    ra:nama "Suku Batak Angkola" ;
    rdfs:label "Suku Batak Angkola" ;
    ra:menuturkanBahasa ra:bhs_angkola ;
    ra:berkerabatDenganSuku ra:suku_batak_mandailing, ra:suku_batak_angkola_mandailing, ra:suku_batak_toba .

ra:suku_batak_angkola_mandailing a ra:Suku ;
    ra:nama "Suku Batak Angkola-Mandailing" ;
    rdfs:label "Suku Batak Angkola-Mandailing" ;
    ra:menuturkanBahasa ra:bhs_angkola_mandailing ;
    ra:berkerabatDenganSuku ra:suku_batak_mandailing, ra:suku_batak_angkola .

