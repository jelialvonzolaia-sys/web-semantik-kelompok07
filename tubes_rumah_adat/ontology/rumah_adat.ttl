    ra:menggunakanBahasa ra:bhs_melayu ;
    ra:memilikiOrnamen ra:orn_pucuk_rebung, ra:orn_awan_larat ;
    ra:memilikiTradisi ra:trd_tepung_tawar, ra:trd_jamu_laut .

ra:rumah_replika_istana_darul_arif_serdang_bedagai a ra:RumahAdat ;
    ra:nama "Replika Istana Darul Arif" ;
    rdfs:label "Replika Istana Darul Arif" ;
