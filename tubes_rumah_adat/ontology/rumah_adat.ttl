ra:suku_melayu_langkat a ra:Suku ;
    ra:nama "Suku Melayu Langkat" ;
    rdfs:label "Suku Melayu Langkat" ;
    ra:menuturkanBahasa ra:bhs_melayu_langkat ;
    ra:berkerabatDenganSuku ra:suku_melayu_deli, ra:suku_melayu_pesisir_batu_bara, ra:suku_melayu_serdang, ra:suku_melayu .

ra:suku_batak_toba a ra:Suku ;
