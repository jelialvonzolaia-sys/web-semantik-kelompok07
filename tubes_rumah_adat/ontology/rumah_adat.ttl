    ra:memilikiOrnamen ra:orn_gorga ;
    ra:memilikiTradisi ra:trd_manortor .

# --- D. Toba — Rumah Bolon Jangga Dolok (TOB-03) ---
ra:rumah_bolon_jangga_dolok a ra:RumahAdat ;
    ra:nama "Rumah Bolon Jangga Dolok" ;
    ra:namaAlternatif "Rumah Adat Jangga Dolok" ;
    ra:sejarah "Desa adat tradisional di Kecamatan Lumban Julu, Kabupaten Toba, dengan rumah adat yang diperkirakan berusia sekitar 250 tahun." ;
    ra:fungsi "Warisan permukiman adat dan destinasi budaya" ;
