    ra:maknaFilosofis "Memerlukan pendataan dan survei lapangan lanjutan bersama dinas kebudayaan daerah." ;
    ra:referensi "Dokumen Inventarisasi Rumah Adat Sumatera Utara (Bagian Patricia)" ;
    ra:berasalDariWilayah ra:wil_kab_asahan, ra:wil_kota_tanjungbalai, ra:wil_kota_tebing_tinggi, ra:wil_kab_labuhanbatu, ra:wil_kab_labuhanbatu_utara, ra:wil_kab_labuhanbatu_selatan ;
    ra:dimilikiOlehSuku ra:suku_melayu ;
