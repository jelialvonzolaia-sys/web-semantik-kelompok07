ra:rumah_istana_niat_lima_laras_batubara a ra:RumahAdat ;
    ra:nama "Istana Niat Lima Laras" ;
    rdfs:label "Istana Niat Lima Laras" ;
    ra:namaAlternatif "Istana Datuk Muhammad Yuda" ;
    ra:sejarah "Dibangun pada tahun 1907-1912 oleh Datuk Muhammad Yuda sebagai pemenuhan nazar di Desa Lima Laras, Kecamatan Tanjung Tiram, Kabupaten Batu Bara." ;
    ra:fungsi "Istana kediaman dan pusat kedatuan Melayu Lima Laras" ;
    ra:ciriArsitektur "Perpaduan arsitektur Melayu dan Eropa bertingkat 4 dengan 6 anjungan, 28 pintu, dan 66 pasang jendela" ;
    ra:bentukAtap "Atap limas Melayu bertingkat yang megah" ;
    ra:bahanBangunan "Kombinasi beton, kayu ulin atau meranti, kaca patri, serta ragam hias Melayu seperti motif itik pulang petang, pucuk rebung, dan awan larat" ;
    ra:maknaFilosofis "Kehormatan, pemenuhan nazar (niat), dan keagungan tradisi bahari Melayu Batu Bara." ;
    ra:referensi "Disporabudpar Batu Bara: https://disporabudpar.batubarakab.go.id/ ; Jurnal Community UTU: https://jurnal.utu.ac.id/jcommunity/article/download/6651/3769" ;
