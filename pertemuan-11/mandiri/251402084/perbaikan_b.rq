
PREFIX ex: <http://contoh.id/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <https://schema.org/>

# Kasus B — Normalisasi nama

CONSTRUCT {
    ?o ex:nama ?namaNormal .
}
WHERE {
    VALUES ?o {
        dbr:Christopher_Nolan
        dbr:Joko_Anwar
        dbr:Mira_Lesmana
    }

    ?o foaf:name|rdfs:label|schema:name ?n .

    BIND(STR(?n) AS ?namaNormal)
}
